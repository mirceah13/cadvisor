# ============================================================
# CADVisor - Local Development Environment
# ============================================================
# Copy this file to .env and fill in your personal API keys.
# Everything else is pre-configured for the local Docker stack.
#
#   cp .env.local.example .env
#
# Then start the stack:
#   docker-compose up           (foreground, see all logs)
#   docker-compose up -d        (background)
#
# Run migrations (first time or after a pull):
#   make migrate
# ============================================================

# -------------------------------------------------------
# Application
# -------------------------------------------------------
NODE_ENV=development
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=info

# -------------------------------------------------------
# Database  (local postgres container — pgvector enabled)
# -------------------------------------------------------
POSTGRES_USER=cadvisor
POSTGRES_PASSWORD=cadvisor_local
POSTGRES_DB=cadvisor
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://cadvisor:cadvisor_local@localhost:5432/cadvisor

# -------------------------------------------------------
# Redis  (local redis container)
# -------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# -------------------------------------------------------
# MinIO  (local S3-compatible storage)
# MinIO Docker port: 9002 (external) → 9000 (internal)
# Console at http://localhost:9001  (admin/minioadmin_local)
# -------------------------------------------------------
MINIO_ENDPOINT=minio:9000
MINIO_EXTERNAL_ENDPOINT=localhost:9002
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin_local
MINIO_USE_SSL=false
MINIO_BUCKET_NAME=cadvisor-files
MINIO_REGION=us-east-1

# -------------------------------------------------------
# Security  (any random strings are fine for local dev)
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# -------------------------------------------------------
JWT_SECRET=local_dev_jwt_secret_change_for_prod_minimum_32_chars
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

SESSION_SECRET=local_dev_session_secret_change_for_prod_32chars

# -------------------------------------------------------
# Jina AI  (same key used in production — free tier OK)
# Get yours at https://jina.ai  →  Dashboard → API Keys
# -------------------------------------------------------
JINA_API_KEY=jina_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# -------------------------------------------------------
# Ollama  (local LLM — optional, only needed for analysis)
# Models are downloaded on first use (~4 GB).
# Skip by not starting the ollama service:
#   docker-compose up postgres redis minio api celery-worker web
# -------------------------------------------------------
OLLAMA_BASE_URL=http://ollama:11434
DEFAULT_LLM_MODEL=mistral:7b-instruct
DEFAULT_EMBEDDING_MODEL=nomic-embed-text
OLLAMA_NUM_PARALLEL=2
OLLAMA_MAX_LOADED_MODELS=1

# -------------------------------------------------------
# CORS / API URLs
# -------------------------------------------------------
CORS_ORIGINS=http://localhost:3000
API_BASE_URL=http://localhost:8000
AI_SERVICE_BASE_URL=http://ai:8001

# -------------------------------------------------------
# NextAuth  (web frontend auth)
# -------------------------------------------------------
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=local_dev_nextauth_secret_change_for_prod

# Internal API URL (container-to-container)
INTERNAL_API_URL=http://api:8000
# Public API URL (browser → host)
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=CADVisor

# -------------------------------------------------------
# OAuth providers  (optional for local testing)
# Leave blank to use email/password auth only
# -------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# -------------------------------------------------------
# Autodesk Platform Services  (optional — DWG conversion)
# -------------------------------------------------------
APS_CLIENT_ID=
APS_CLIENT_SECRET=

# -------------------------------------------------------
# Celery tuning
# -------------------------------------------------------
CELERY_WORKERS=2
EMBEDDING_DIMENSION=768

# -------------------------------------------------------
# Billing (mock in local dev)
# -------------------------------------------------------
BILLING_PROVIDER=mock
