# ============================================================
# CADVisor — Production Environment Variables
# Set these in each platform's dashboard:
#   [R] = Railway   (API, Worker, AI services)
#   [V] = Vercel    (Web frontend)
#   [B] = Both Railway + Vercel where needed
# ============================================================

# ---- Application ----------------------------------------
NODE_ENV=production                                             # [V]
ENVIRONMENT=production                                          # [R]
LOG_LEVEL=info                                                  # [R]

# ---- PostgreSQL (Neon) ----------------------------------
# Get from: https://console.neon.tech → your DB → Connection Details
# Use the "pooled" connection string for the API.
DATABASE_URL=postgresql://user:pass@ep-xxx.us-east-2.aws.neon.tech/cadvisor?sslmode=require  # [R]

# ---- Redis (Upstash) ------------------------------------
# Get from: https://console.upstash.com → your DB → REST API → Redis URL
REDIS_URL=rediss://default:TOKEN@HOSTNAME.upstash.io:PORT       # [R]
CELERY_BROKER_URL=rediss://default:TOKEN@HOSTNAME.upstash.io:PORT  # [R]
CELERY_RESULT_BACKEND=rediss://default:TOKEN@HOSTNAME.upstash.io:PORT  # [R]

# ---- Cloudflare R2 (replaces MinIO) ---------------------
# Get from: Cloudflare dashboard → R2 → your bucket → API tokens
# Endpoint format: https://<ACCOUNT_ID>.r2.cloudflarestorage.com
MINIO_ENDPOINT=<ACCOUNT_ID>.r2.cloudflarestorage.com           # [R] (no https://)
MINIO_ACCESS_KEY=<R2_ACCESS_KEY_ID>                             # [R]
MINIO_SECRET_KEY=<R2_SECRET_ACCESS_KEY>                         # [R]
MINIO_ROOT_USER=<R2_ACCESS_KEY_ID>                              # [R]
MINIO_ROOT_PASSWORD=<R2_SECRET_ACCESS_KEY>                      # [R]
MINIO_USE_SSL=true                                              # [R]
MINIO_BUCKET_NAME=cadvisor-files                                # [R]
MINIO_EXTERNAL_ENDPOINT=<ACCOUNT_ID>.r2.cloudflarestorage.com  # [R]

# ---- LLM — Groq (replaces Ollama) ----------------------
# Get from: https://console.groq.com → API Keys
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxx                           # [R - AI service]
DEFAULT_LLM_MODEL=llama-3.3-70b-versatile                       # [R - AI service]
DEFAULT_EMBEDDING_MODEL=nomic-embed-text                        # [R - AI service]
# Keep this pointing at the Railway AI service internal URL:
OLLAMA_BASE_URL=http://cadvisor-ai.railway.internal:8001        # [R - API + Worker]

# ---- Authentication & Security --------------------------
# Generate with:  openssl rand -hex 32
JWT_SECRET=<32+_char_random_string>                             # [R]
SESSION_SECRET=<32+_char_random_string>                         # [R]
NEXTAUTH_SECRET=<32+_char_random_string>                        # [V]

# ---- Service URLs ---------------------------------------
# Fill in your actual Railway service URLs after first deploy
NEXT_PUBLIC_API_URL=https://cadvisor-api.up.railway.app         # [V] (build-time)
NEXT_PUBLIC_APP_URL=https://cadvisor.vercel.app                 # [V] (build-time)
NEXT_PUBLIC_APP_NAME=CADVisor                                   # [V] (build-time)
NEXT_PUBLIC_MAX_FILE_SIZE_MB=500                                 # [V] (build-time)
NEXTAUTH_URL=https://cadvisor.vercel.app                        # [V]

# Internal URL used by Vercel SSR to reach the API without going public:
INTERNAL_API_URL=https://cadvisor-api.up.railway.app            # [V]

# AI service URL (Railway internal networking, no public egress charge):
AI_SERVICE_BASE_URL=http://cadvisor-ai.railway.internal:8001    # [R]

# ---- CORS -----------------------------------------------
CORS_ORIGINS=https://cadvisor.vercel.app                        # [R]

# ---- Autodesk APS (optional, for DWG via Forge) ---------
APS_CLIENT_ID=                                                  # [R]
APS_CLIENT_SECRET=                                              # [R]

# ---- OAuth providers (optional) -------------------------
# GOOGLE_CLIENT_ID=                                             # [V]
# GOOGLE_CLIENT_SECRET=                                         # [V]

# ---- Celery ---------------------------------------------
CELERY_WORKERS=2                                                # [R - Worker]
CELERY_TASK_SERIALIZER=json
CELERY_RESULT_SERIALIZER=json
CELERY_ACCEPT_CONTENT=json
CELERY_TIMEZONE=UTC

# ---- Misc -----------------------------------------------
EMBEDDING_DIMENSION=768                                         # [R]
CHUNK_SIZE=1000                                                 # [R]
CHUNK_OVERLAP=200                                               # [R]
RAG_TOP_K=10                                                    # [R]
ANALYSIS_TIMEOUT_SECONDS=300                                    # [R]
