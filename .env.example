# ============================================
# CADVisor - Environment Variables
# ============================================

# -----------------
# Application
# -----------------
NODE_ENV=development
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=info

# -----------------
# Database
# -----------------
POSTGRES_USER=cadvisor
POSTGRESS_PASSWORD=cadvisor_secure_password_change_in_prod
POSTGRES_DB=cadvisor
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# -----------------
# Redis
# -----------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://${REDIS_HOST}:${REDIS_PORT}/0

# -----------------
# MinIO (S3-compatible storage)
# -----------------
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin_change_in_prod
MINIO_ENDPOINT=minio:9000
MINIO_EXTERNAL_ENDPOINT=localhost:9000
MINIO_USE_SSL=false
MINIO_BUCKET_NAME=cadvisor-files
MINIO_REGION=us-east-1

# -----------------
# Authentication & Security
# -----------------
JWT_SECRET=generate_a_strong_random_secret_minimum_32_chars
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

SESSION_SECRET=generate_another_strong_random_secret_32_chars
SESSION_COOKIE_NAME=buildguard_session
SESSION_MAX_AGE=3600

# Argon2 settings (defaults are secure)
PASSWORD_HASH_TIME_COST=2
PASSWORD_HASH_MEMORY_COST=65536
PASSWORD_HASH_PARALLELISM=4

# -----------------
# Ollama (Local LLM)
# -----------------
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_HOST=0.0.0.0:11434
DEFAULT_LLM_MODEL=mistral:7b-instruct
DEFAULT_EMBEDDING_MODEL=nomic-embed-text
OLLAMA_NUM_PARALLEL=2
OLLAMA_MAX_LOADED_MODELS=2

# -----------------
# AI Configuration
# -----------------
# Chunking
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
MAX_CHUNKS_PER_SOURCE=10000

# RAG
RAG_TOP_K=10
RAG_SIMILARITY_THRESHOLD=0.7
RAG_MAX_CONTEXT_LENGTH=8000

# Analysis
ANALYSIS_TIMEOUT_SECONDS=600
ANALYSIS_CONFIDENCE_THRESHOLD=0.6
ANALYSIS_REQUIRE_HUMAN_REVIEW_THRESHOLD=0.75

# Embeddings dimension (nomic-embed-text = 768)
EMBEDDING_DIMENSION=768

# -----------------
# Celery
# -----------------
CELERY_BROKER_URL=${REDIS_URL}
CELERY_RESULT_BACKEND=${REDIS_URL}
CELERY_TASK_SERIALIZER=json
CELERY_RESULT_SERIALIZER=json
CELERY_ACCEPT_CONTENT=json
CELERY_TIMEZONE=UTC
CELERY_WORKERS=4
CELERY_MAX_TASKS_PER_CHILD=1000

# -----------------
# API Service
# -----------------
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4
API_RELOAD=true
API_BASE_URL=http://localhost:8000

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
CORS_CREDENTIALS=true

# Rate limiting
RATE_LIMIT_AUTH_PER_MINUTE=5
RATE_LIMIT_API_PER_MINUTE=100

# -----------------
# AI Service
# -----------------
AI_SERVICE_HOST=0.0.0.0
AI_SERVICE_PORT=8001
AI_SERVICE_WORKERS=2
AI_SERVICE_BASE_URL=http://ai:8001

# -----------------
# Web Frontend
# -----------------
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_NAME=BuildGuard Advisor
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_MAX_FILE_SIZE_MB=2048
NEXT_PUBLIC_ENVIRONMENT=development

# -----------------
# File Processing
# -----------------
MAX_UPLOAD_SIZE_BYTES=2147483648
ALLOWED_MIME_TYPES=application/pdf,application/vnd.openxmlformats-officedocument.wordprocessingml.document,text/plain,image/png,image/jpeg,application/ifc,image/vnd.dxf,application/dxf,application/step,application/iges
ENABLE_FILE_SCANNING=false
CLAMAV_HOST=clamav
CLAMAV_PORT=3310

# Presigned URL TTL (seconds)
PRESIGNED_URL_EXPIRY=900

# -----------------
# Billing & Subscriptions
# -----------------
BILLING_PROVIDER=mock
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=

# Trial settings
DEFAULT_TRIAL_DAYS=14

# Plan limits (JSON format)
PLAN_LIMITS_TRIAL={"max_projects":3,"max_submissions_per_month":10,"max_file_size_mb":50,"max_analysis_per_day":5}
PLAN_LIMITS_PRO={"max_projects":20,"max_submissions_per_month":100,"max_file_size_mb":500,"max_analysis_per_day":50}
PLAN_LIMITS_TEAM={"max_projects":999,"max_submissions_per_month":500,"max_file_size_mb":2048,"max_analysis_per_day":200}

# -----------------
# Email (Optional)
# -----------------
ENABLE_EMAIL_VERIFICATION=false
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@cadvisor.example
SMTP_FROM_NAME=CADVisor

# -----------------
# Monitoring & Observability
# -----------------
ENABLE_METRICS=true
METRICS_PORT=9090
SENTRY_DSN=

# -----------------
# Feature Flags
# -----------------
FEATURE_FLAG_3D_VIEWER=false
FEATURE_FLAG_REALTIME_COLLAB=false
FEATURE_FLAG_WEBHOOKS=false
FEATURE_FLAG_MOBILE_APP=false

# -----------------
# Data Retention
# -----------------
SOFT_DELETE_RETENTION_DAYS=90
AUDIT_LOG_RETENTION_DAYS=365
